# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GeniusPay : mock = paiement simulé en local, live = vrai paiement
GENIUSPAY_MODE=mock
GENIUSPAY_API_URL=
GENIUSPAY_API_KEY=
GENIUSPAY_WEBHOOK_SECRET=

# Protège la tâche d'expiration des boosts (Vercel l'envoie en Bearer)
CRON_SECRET=

# E-mails Resend (resend.com > API Keys). Sans clé : mode simulation, rien n'est envoyé.
RESEND_API_KEY=
# Expéditeur sur votre domaine vérifié dans Resend, ex. Bricolo <contact@votre-domaine.com>
EMAIL_FROM=
EMAIL_REPLY_TO=
# Signe les liens de désabonnement (si vide, CRON_SECRET est utilisé)
UNSUBSCRIBE_SECRET=
# Secret du webhook Resend (rebonds et plaintes), whsec_...
RESEND_WEBHOOK_SECRET=
